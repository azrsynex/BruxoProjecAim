    row.Size = UDim2.new(1, 0, 0, 42)
    row.BackgroundColor3 = C.BgRow
    row.BackgroundTransparency = 0.1
    row.BorderSizePixel = 0
    row.Text = ""
    row.ZIndex = 14
    row.Parent = wrap
    mkCorner(9, row)
    mkStroke(1, C.Border, 0.5, row)

    local lbl = Instance.new("TextLabel")
    lbl.Size = UDim2.new(0.5, 0, 1, 0)
    lbl.Position = UDim2.new(0, 14, 0, 0)
    lbl.Text = labelText
    lbl.TextSize = 12
    lbl.Font = Enum.Font.Gotham
    lbl.TextColor3 = C.Text
    lbl.TextXAlignment = Enum.TextXAlignment.Left
    lbl.BackgroundTransparency = 1
    lbl.ZIndex = 15
    lbl.Parent = row

    local valLbl = Instance.new("TextLabel")
    valLbl.Size = UDim2.new(0.45, 0, 1, 0)
    valLbl.Position = UDim2.new(0.5, 0, 0, 0)
    valLbl.Text = "▾  " .. current
    valLbl.TextSize = 11
    valLbl.Font = Enum.Font.GothamBold
    valLbl.TextColor3 = C.PurpleNeon
    valLbl.TextXAlignment = Enum.TextXAlignment.Right
    valLbl.BackgroundTransparency = 1
    valLbl.ZIndex = 15
    valLbl.Parent = row

    local expanded = false
    local ddFrame = nil

    row.MouseButton1Click:Connect(function()
        if expanded then
            if ddFrame then ddFrame:Destroy(); ddFrame = nil end
            expanded = false
            wrap.Size = UDim2.new(1, 0, 0, 42)
        else
            ddFrame = Instance.new("Frame")
            ddFrame.Size = UDim2.new(1, 0, 0, #options * 36)
            ddFrame.Position = UDim2.new(0, 0, 0, 44)
            ddFrame.BackgroundColor3 = C.BgCard
            ddFrame.BackgroundTransparency = 0
            ddFrame.BorderSizePixel = 0
            ddFrame.ZIndex = 20
            ddFrame.Parent = wrap
            mkCorner(9, ddFrame)
            mkStroke(1, C.Border, 0.4, ddFrame)
            for i, opt in ipairs(options) do
                local optBtn = Instance.new("TextButton")
                optBtn.Size = UDim2.new(1, 0, 0, 36)
                optBtn.Position = UDim2.new(0, 0, 0, (i-1)*36)
                optBtn.Text = opt
                optBtn.TextSize = 11
                optBtn.Font = Enum.Font.Gotham
                optBtn.TextColor3 = (opt == current) and C.PurpleNeon or C.Text
                optBtn.BackgroundColor3 = (opt == current) and C.BgRow or C.BgCard
                optBtn.BackgroundTransparency = 0.1
                optBtn.BorderSizePixel = 0
                optBtn.ZIndex = 21
                optBtn.Parent = ddFrame
                optBtn.MouseButton1Click:Connect(function()
                    current = opt
                    valLbl.Text = "▾  " .. opt
                    callback(opt)
                    if ddFrame then ddFrame:Destroy(); ddFrame = nil end
                    expanded = false
                    wrap.Size = UDim2.new(1, 0, 0, 42)
                    showNotification(labelText .. ": " .. opt, C.Success)
                end)
            end
            wrap.Size = UDim2.new(1, 0, 0, 42 + #options * 36 + 4)
            expanded = true
        end
    end)

    return wrap
end

