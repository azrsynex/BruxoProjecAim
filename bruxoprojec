local function applyRadar()
    if radarFrame then radarFrame:Destroy() end
    if RadarEnabled then
        radarFrame = Instance.new("Frame")
        radarFrame.Size = UDim2.new(0, 140, 0, 140)
        radarFrame.Position = UDim2.new(0, 15, 0.8, -70)
        radarFrame.BackgroundColor3 = C.Bg
        radarFrame.BackgroundTransparency = 0.3
        radarFrame.BorderSizePixel = 0
        radarFrame.ZIndex = 20
        radarFrame.Parent = Camera
        local rc = Instance.new("UICorner"); rc.CornerRadius = UDim.new(0, 10); rc.Parent = radarFrame
        local rs = Instance.new("UIStroke"); rs.Thickness = 1; rs.Color = C.Purple; rs.Transparency = 0.4; rs.Parent = radarFrame
        local center = Instance.new("Frame")
        center.Size = UDim2.new(0, 6, 0, 6)
        center.Position = UDim2.new(0.5, -3, 0.5, -3)
        center.BackgroundColor3 = C.Text
        center.ZIndex = 21; center.Parent = radarFrame
        Instance.new("UICorner", center).CornerRadius = UDim.new(1, 0)
        local radarUpdate = RunService.RenderStepped:Connect(function()
            if not RadarEnabled then radarUpdate:Disconnect(); return end
            for _, child in ipairs(radarFrame:GetChildren()) do
                if child ~= center and child:IsA("Frame") then child:Destroy() end
            end
            local localPos = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
            if not localPos then return end
            for _, plr in ipairs(Players:GetPlayers()) do
                if plr ~= LocalPlayer and (not TeamCheck or plr.Team ~= LocalPlayer.Team) then
                    local char = plr.Character
                    if char then
                        local hrp = char:FindFirstChild("HumanoidRootPart")
                        if hrp then
                            local delta = hrp.Position - localPos.Position
                            local angle = math.atan2(delta.Z, delta.X) - Camera.CFrame:ToEulerAnglesXYZ().Y
                            local dist = math.min(delta.Magnitude / 15, 55)
                            local x = 70 + math.sin(angle) * dist
                            local z = 70 + math.cos(angle) * dist
                            local dot = Instance.new("Frame")
                            dot.Size = UDim2.new(0, 6, 0, 6)
                            dot.Position = UDim2.new(0, x - 3, 0, z - 3)
                            dot.BackgroundColor3 = C.Danger
                            dot.ZIndex = 21; dot.Parent = radarFrame
                            Instance.new("UICorner", dot).CornerRadius = UDim.new(1, 0)
                        end
                    end
                end
            end
        end)
        table.insert(connections, radarUpdate)
    end
end

