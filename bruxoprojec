local function applyAlwaysAuto()
    if autoShootConnection then autoShootConnection:Disconnect() end
    autoShootConnection = UserInputService.InputBegan:Connect(function(input, gp)
        if gp then return end
        if AlwaysAutoEnabled and input.UserInputType == Enum.UserInputType.MouseButton1 then
            isShooting = true
            while isShooting and AlwaysAutoEnabled do
                local w = getCurrentWeapon()
                if w then
                    local se = w:FindFirstChild("Shoot")
                    if se and se:IsA("RemoteEvent") then se:FireServer() end
                end
                task.wait(FastFireRateValue)
            end
        end
    end)
    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then isShooting = false end
    end)
end

