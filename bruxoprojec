-- ========== UTILITÁRIOS ==========
local function getCurrentWeapon()
    local char = LocalPlayer.Character
    if not char then return nil end
    for _, tool in ipairs(char:GetChildren()) do
        if tool:IsA("Tool") then return tool end
    end
    return nil
end

local function showHitmarker()
    local hitmarker = Instance.new("Frame")
    hitmarker.Size = UDim2.new(0, 50, 0, 50)
    hitmarker.Position = UDim2.new(0.5, -25, 0.5, -25)
    hitmarker.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
    hitmarker.BackgroundTransparency = 0.5
    hitmarker.BorderSizePixel = 0
    hitmarker.Parent = Camera
    Instance.new("UICorner", hitmarker).CornerRadius = UDim.new(1, 0)
    TweenService:Create(hitmarker, TweenInfo.new(0.1), {BackgroundTransparency = 0}):Play()
    task.wait(0.1)
    TweenService:Create(hitmarker, TweenInfo.new(0.1), {BackgroundTransparency = 1}):Play()
    task.wait(0.1)
    hitmarker:Destroy()
end

-- ========== INVISIBILIDADE CORRIGIDA ==========
local function applyInvisibility()
    if invisibleConnection then invisibleConnection:Disconnect() end
    
    if InvisibleEnabled then
        print("[INVISIBLE] Ativando invisibilidade...")
        
        -- Função para tornar um personagem invisível
        local function makeInvisible(character)
            if not character then return end
            
            -- Partes do corpo
            for _, part in ipairs(character:GetDescendants()) do
                if part:IsA("BasePart") then
                    pcall(function()
                        part.Transparency = 1
                        part.CanCollide = not noclipEnabled
                        part.Material = Enum.Material.SmoothPlastic
                    end)
                elseif part:IsA("Decal") then
                    pcall(function() part.Transparency = 1 end)
                elseif part:IsA("Accessory") and part.Handle then
                    pcall(function() part.Handle.Transparency = 1 end)
                elseif part:IsA("MeshPart") then
                    pcall(function() part.Transparency = 1 end)
                end
            end
            
            -- Humanoid
            local hum = character:FindFirstChild("Humanoid")
            if hum then
                pcall(function() 
                    hum.Visible = false
                    hum.BreakJointsOnDeath = false
                end)
            end
            
            -- Remover efeitos visuais
            for _, effect in ipairs(character:GetDescendants()) do
                if effect:IsA("Trail") or effect:IsA("ParticleEmitter") or effect:IsA("Smoke") or effect:IsA("Fire") or effect:IsA("Sparkles") then
                    pcall(function() effect.Enabled = false end)
                end
            end
            
            -- Roupas (Shirt, Pants)
            local shirt = character:FindFirstChild("Shirt")
            local pants = character:FindFirstChild("Pants")
            if shirt then pcall(function() shirt.Visible = false end) end
            if pants then pcall(function() pants.Visible = false end) end
        end
        
        -- Aplicar invisibilidade imediatamente
        local char = LocalPlayer.Character
        if char then
            makeInvisible(char)
        end
        
        -- Loop para manter invisível (força a cada frame)
        invisibleConnection = RunService.RenderStepped:Connect(function()
            if InvisibleEnabled then
                local charNow = LocalPlayer.Character
                if charNow then
                    for _, part in ipairs(charNow:GetDescendants()) do
                        if part:IsA("BasePart") then
                            if part.Transparency < 1 then
                                pcall(function() part.Transparency = 1 end)
                            end
                            pcall(function() part.CanCollide = not noclipEnabled end)
                        elseif part:IsA("Decal") and part.Transparency < 1 then
                            pcall(function() part.Transparency = 1 end)
                        elseif part:IsA("Accessory") and part.Handle and part.Handle.Transparency < 1 then
                            pcall(function() part.Handle.Transparency = 1 end)
                        elseif part:IsA("MeshPart") and part.Transparency < 1 then
                            pcall(function() part.Transparency = 1 end)
                        end
                    end
                    
                    local hum = charNow:FindFirstChild("Humanoid")
                    if hum and hum.Visible == true then
                        pcall(function() hum.Visible = false end)
                    end
                    
                    local shirt = charNow:FindFirstChild("Shirt")
                    local pants = charNow:FindFirstChild("Pants")
                    if shirt and shirt.Visible == true then pcall(function() shirt.Visible = false end) end
                    if pants and pants.Visible == true then pcall(function() pants.Visible = false end) end
                end
            end
        end)
        
        print("[INVISIBLE] ✓ Ativado! Você está invisível!")
    else
        -- Restaurar visibilidade
        local char = LocalPlayer.Character
        if char then
            for _, part in ipairs(char:GetDescendants()) do
                if part:IsA("BasePart") then
                    pcall(function() 
                        part.Transparency = 0
                        part.CanCollide = true
                    end)
                elseif part:IsA("Decal") then
                    pcall(function() part.Transparency = 0 end)
                elseif part:IsA("Accessory") and part.Handle then
                    pcall(function() part.Handle.Transparency = 0 end)
                elseif part:IsA("MeshPart") then
                    pcall(function() part.Transparency = 0 end)
                end
            end
            
            local hum = char:FindFirstChild("Humanoid")
            if hum then
                pcall(function() hum.Visible = true end)
            end
            
            local shirt = char:FindFirstChild("Shirt")
            local pants = char:FindFirstChild("Pants")
            if shirt then pcall(function() shirt.Visible = true end) end
            if pants then pcall(function() pants.Visible = true end) end
            
            for _, effect in ipairs(char:GetDescendants()) do
                if effect:IsA("Trail") or effect:IsA("ParticleEmitter") or effect:IsA("Smoke") or effect:IsA("Fire") or effect:IsA("Sparkles") then
                    pcall(function() effect.Enabled = true end)
                end
            end
        end
        
        if invisibleConnection then
            invisibleConnection:Disconnect()
            invisibleConnection = nil
        end
        print("[INVISIBLE] ✓ Desativado! Você está visível novamente!")
    end
end

-- ========== NOCLIP (ATRAVESSAR PAREDES) ==========
local function applyNoclip()
    if noclipConnection then noclipConnection:Disconnect() end
    
    if noclipEnabled then
        print("[NOCLIP] Ativado - Você pode atravessar paredes!")
        noclipConnection = RunService.RenderStepped:Connect(function()
            local char = LocalPlayer.Character
            if char and noclipEnabled then
                for _, part in ipairs(char:GetDescendants()) do
                    if part:IsA("BasePart") then
                        pcall(function() part.CanCollide = false end)
                    end
                end
            end
        end)
    else
        local char = LocalPlayer.Character
        if char then
            for _, part in ipairs(char:GetDescendants()) do
                if part:IsA("BasePart") then
                    pcall(function() part.CanCollide = true end)
                end
            end
        end
        if noclipConnection then
            noclipConnection:Disconnect()
            noclipConnection = nil
        end
        print("[NOCLIP] Desativado")
    end
end

