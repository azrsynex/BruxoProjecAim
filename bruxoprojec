-- Função para atualizar CanvasSize
local function updateCanvas(panel)
    local container = panel.container
    local scroll = panel.scroll
    task.wait()
    local height = 0
    for _, child in ipairs(container:GetChildren()) do
        if child:IsA("GuiObject") then
            local y = child.Position.Y.Offset + child.Size.Y.Offset
            if y > height then height = y end
        end
    end
    scroll.CanvasSize = UDim2.new(0, 0, 0, height + 20)
end

-- Função para criar botão toggle
local function createToggle(parent, y, text, initialState, callback)
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(1, -10, 0, 42)
    btn.Position = UDim2.new(0, 5, 0, y)
    btn.Text = text .. ": " .. (initialState and "ON" or "OFF")
    btn.TextColor3 = Color3.fromRGB(220, 220, 240)
    btn.TextSize = 13
    btn.Font = Enum.Font.Gotham
    btn.BackgroundColor3 = initialState and Color3.fromRGB(80, 180, 240) or Color3.fromRGB(35, 35, 50)
    btn.BorderSizePixel = 1
    btn.BorderColor3 = Color3.fromRGB(50, 50, 70)
    btn.Parent = parent
    Instance.new("UICorner", btn).CornerRadius = UDim.new(0, 8)
    
    local state = initialState
    btn.MouseButton1Click:Connect(function()
        state = not state
        btn.Text = text .. ": " .. (state and "ON" or "OFF")
        btn.BackgroundColor3 = state and Color3.fromRGB(80, 180, 240) or Color3.fromRGB(35, 35, 50)
        callback(state)
    end)
    return btn
end

