    valueLabel.BackgroundTransparency = 1
    valueLabel.Parent = frame
    
    UserInputService.InputChanged:Connect(function(input)
        if dragging and input.UserInputType == Enum.UserInputType.MouseMovement then
            local mouseX = input.Position.X
            local sliderX = slider.AbsolutePosition.X
            local sliderW = slider.AbsoluteSize.X
            if sliderW > 0 then
                local newPercent = math.clamp((mouseX - sliderX) / sliderW, 0, 1)
                local value = minVal + (newPercent * (maxVal - minVal))
                value = math.floor(value * 10) / 10
                if text == "Smoothness" then value = math.floor(value * 100) / 100 end
                valueLabel.Text = tostring(value)
                fill.Size = UDim2.new(newPercent, 0, 1, 0)
                knob.Position = UDim2.new(newPercent, -6, 0.5, -6)
                callback(value)
            end
        end
    end)
    
    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 then dragging = false end
    end)
    
    return frame
end

